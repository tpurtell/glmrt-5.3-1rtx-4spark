PROFILE=balanced
MODEL=glm53-exl3
CONCURRENCY=4
VISION_MODEL=baseten
SPECULATION=dflash2
# Route-bank collection uses the widest DFlash2 trajectory so every smaller
# counterfactual verification prefix can be sampled from the same real route.
DFLASH2_FIXED_DRAFTS=7
DFLASH2_TOPK_BACKEND=torch
SPARKINFER_GLM_H64_QUERY_PROJECTION=auto

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4
SPARK_0_LANE_B=10.55.0.5
SPARK_1_LANE_B=10.55.0.6
SPARK_2_LANE_B=10.55.0.7
SPARK_3_LANE_B=10.55.0.8

COORDINATOR_DOCKER_DEV=glrmt-coordinator-dev
COORDINATOR_DOCKER_INFERENCE=glrmt-coordinator
SPARK_EXPERT_DOCKER_DEV=glrmt-spark-expert-dev
SPARK_EXPERT_DOCKER_INFERENCE=glrmt-spark-expert
