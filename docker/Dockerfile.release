ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
FROM ${BASE_IMAGE} AS inference

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_SYSTEM_PYTHON=1
ENV PATH=/opt/glmrt/bin:${PATH}
ENV PYTHONPATH=/opt/glmrt/third_party/sparkinfer:/opt/glmrt/python/reference/glmrt_reference:/opt/glmrt/python/reference
ENV GLMRT_NATIVE_LIB=/opt/glmrt/lib/libglmrt_native.so
ENV GLMRT_VISION_WORKER=/opt/glmrt/python/tools/glmrt_vision_worker.py

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash ca-certificates curl jq tini \
      rdma-core ibverbs-providers libibverbs1 \
      libnl-3-200 libnl-route-3-200 \
      iproute2 pciutils netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir uv && \
    uv pip install --system --break-system-packages --no-cache \
      safetensors \
      huggingface-hub \
      "nvidia-cutlass-dsl[cu13]==4.6.2" \
      "apache-tvm-ffi==0.1.12" \
      "cuda-tile==1.5.0" \
      "nvidia-cudnn-frontend==1.26.0" \
      "einops==0.8.2" \
      "ninja==1.13.0" \
      "nvidia-ml-py==13.610.43" \
      "pillow>=11,<13" \
      "tabulate==0.10.0" \
      "transformers==5.13.0" \
      "rich==15.0.0" && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      "flashinfer-python==0.6.14" && \
    python3 -c 'import PIL, torch; print(PIL.__version__, torch.__version__)'

# The NGC 26.05 base declares pytest as a runtime requirement of its bundled
# triton-kernels distribution. Keep the release environment dependency-complete
# so the source-pinned SparkInfer installation can be checked globally below.
RUN uv pip install --system --break-system-packages --no-cache pytest

# Keep source/revision metadata after the expensive immutable dependency
# layers. Rapid SparkInfer iteration should invalidate only the pinned-source
# and release-material tail of this image.
ARG GLMRT_ROLE
ARG CUDA_ARCH
ARG GLMRT_ENGINE_COMMIT=unknown
ARG GLMRT_SPARKINFER_COMMIT=unknown

ENV GLMRT_ROLE=${GLMRT_ROLE}
ENV GLMRT_CUDA_ARCH=${CUDA_ARCH}
ENV GLMRT_ENGINE_COMMIT=${GLMRT_ENGINE_COMMIT}
ENV GLMRT_SPARKINFER_COMMIT=${GLMRT_SPARKINFER_COMMIT}

LABEL org.opencontainers.image.title="GLMRT GLM-5.3 inference"
LABEL org.opencontainers.image.source="https://github.com/tpurtell/glmrt-5.3-1rtx-4spark"
LABEL org.opencontainers.image.revision=${GLMRT_ENGINE_COMMIT}
LABEL io.glmrt.role=${GLMRT_ROLE}
LABEL io.glmrt.cuda_arch=${CUDA_ARCH}
LABEL io.glmrt.sparkinfer.revision=${GLMRT_SPARKINFER_COMMIT}

COPY scripts/verify-sparkinfer-source.py /opt/glmrt/scripts/verify-sparkinfer-source.py
COPY scripts/sparkinfer-release-provenance.py /opt/glmrt/scripts/sparkinfer-release-provenance.py
COPY third_party/sparkinfer.lock.json /opt/glmrt/third_party/sparkinfer.lock.json
COPY third_party/sparkinfer /opt/glmrt/third_party/sparkinfer

RUN python3 /opt/glmrt/scripts/verify-sparkinfer-source.py \
      --source /opt/glmrt/third_party/sparkinfer \
      --lock /opt/glmrt/third_party/sparkinfer.lock.json && \
    locked_revision="$(python3 /opt/glmrt/scripts/verify-sparkinfer-source.py \
      --source /opt/glmrt/third_party/sparkinfer \
      --lock /opt/glmrt/third_party/sparkinfer.lock.json \
      --print-revision)" && \
    [ "${GLMRT_SPARKINFER_COMMIT}" != unknown ] && \
    [ "${GLMRT_SPARKINFER_COMMIT}" = "$locked_revision" ] && \
    uv pip install --system --break-system-packages --no-cache --no-deps \
      --editable /opt/glmrt/third_party/sparkinfer && \
    uv pip check && \
    python3 -c 'import importlib.metadata, pathlib, b12x; source = pathlib.Path("/opt/glmrt/third_party/sparkinfer").resolve(); module = pathlib.Path(b12x.__file__).resolve(); assert module.is_relative_to(source), (module, source); print(importlib.metadata.version("b12x"), module)' && \
    python3 /opt/glmrt/scripts/verify-sparkinfer-source.py \
      --source /opt/glmrt/third_party/sparkinfer \
      --lock /opt/glmrt/third_party/sparkinfer.lock.json \
      --require-no-python-cache

COPY .glmrt-release-image/glmrt /opt/glmrt/bin/glmrt
COPY .glmrt-release-image/libglmrt_native.so /opt/glmrt/lib/libglmrt_native.so
COPY .glmrt-release-image/THIRD_PARTY_NOTICES.md /opt/glmrt/share/THIRD_PARTY_NOTICES.md
COPY .glmrt-release-image/SPARKINFER_PROVENANCE.json /opt/glmrt/share/SPARKINFER_PROVENANCE.json
COPY .glmrt-release-image/SPARKINFER_LICENSE /opt/glmrt/share/SPARKINFER_LICENSE
COPY .glmrt-release-image/SPARKINFER_SHA256SUMS /opt/glmrt/share/SPARKINFER_SHA256SUMS
COPY .glmrt-release-image/XGRAMMAR_PROVENANCE.json /opt/glmrt/share/XGRAMMAR_PROVENANCE.json
COPY .glmrt-release-image/XGRAMMAR_LICENSE /opt/glmrt/share/XGRAMMAR_LICENSE
COPY .glmrt-release-image/XGRAMMAR_SHA256SUMS /opt/glmrt/share/XGRAMMAR_SHA256SUMS
COPY python /opt/glmrt/python
COPY scripts/real-full-tcp-serve.sh /opt/glmrt/scripts/real-full-tcp-serve.sh
COPY scripts/kernel-cache-identity.py /opt/glmrt/scripts/kernel-cache-identity.py
COPY docker/release-entrypoint.sh /usr/local/bin/glmrt-release-entrypoint

RUN cmp -s \
      /opt/glmrt/third_party/sparkinfer/LICENSE \
      /opt/glmrt/share/SPARKINFER_LICENSE && \
    (cd /opt/glmrt/share && sha256sum -c SPARKINFER_SHA256SUMS) && \
    (cd /opt/glmrt/share && sha256sum -c XGRAMMAR_SHA256SUMS) && \
    python3 /opt/glmrt/scripts/sparkinfer-release-provenance.py \
      --source /opt/glmrt/third_party/sparkinfer \
      --lock /opt/glmrt/third_party/sparkinfer.lock.json \
      --license /opt/glmrt/share/SPARKINFER_LICENSE \
      --notices /opt/glmrt/share/THIRD_PARTY_NOTICES.md \
      --verify /opt/glmrt/share/SPARKINFER_PROVENANCE.json && \
    install -D -m 0644 \
      /opt/glmrt/share/SPARKINFER_LICENSE \
      /opt/glmrt/share/licenses/sparkinfer/LICENSE && \
    install -D -m 0644 \
      /opt/glmrt/share/XGRAMMAR_LICENSE \
      /opt/glmrt/share/licenses/xgrammar/LICENSE && \
    chmod +x \
      /opt/glmrt/bin/glmrt \
      /opt/glmrt/scripts/real-full-tcp-serve.sh \
      /usr/local/bin/glmrt-release-entrypoint && \
    python3 -c 'import b12x_mla_capture, b12x_spark_capture, dflash_head_capture, dflash_tuning_profile, dspark_capture, dspark_body_capture, dspark_head_capture, dspark_update_capture, triton_kv_pack_capture, triton_mlp_capture, triton_router_capture, triton_sampling_capture'

WORKDIR /opt/glmrt
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/glmrt-release-entrypoint"]
CMD ["glmrt", "--help"]
