###################
# Serving profile #
###################
# balanced  : FP8 target KV (~56.5 KB/tok), 400K sequence cap, 100K max output
# long      : NVFP4 target KV (~39.1 KB/tok), larger pool / longer context
# accuracy  : BF16 target KV (~95.2 KB/tok), BF16 Spark exchange/reduction
PROFILE=balanced

# The public release target is the calibrated GLM-5.3 EXL3 K4 export.
MODEL=glm53-exl3

# Coordinator free-memory floor used by the pool resolver (GiB). Default 8.
# COORDINATOR_GPU_HEADROOM_GIB=8

# Shared target-KV pool. Leave unset to auto-size; must be a multiple of 64.
# Production raptor/balanced is approximately 600K with 8 GiB headroom.
# KV_POOL_TOKENS=

# Total per-request sequence and output budgets. The rendered prompt may use
# the rest of MAX_CONTEXT_TOKENS; there is no fixed MAX_INPUT_TOKENS split.
# Profile defaults: balanced=400K/100K, long=pool/100K, accuracy=200K/50K.
# MAX_CONTEXT_TOKENS=400000
# MAX_OUTPUT_TOKENS=100000

# Active physical workspaces and expert QPs. C=4 is production-qualified.
# C=8 remains diagnostic and is not advertised as supported.
# CONCURRENCY=4

# Thinking is enabled by default for chat/tool requests. API callers can opt
# out per request with enable_thinking=false, thinking.type=disabled, or
# reasoning_effort=none/off/disabled.

# The measured GLM-5.3 release is text-only.
VISION_MODEL=off

######################
# Speculative decode #
######################
# plain=no draft; mtp=native layer 78; dflash2=incoai/GLM-5.3-DFlash2.
SPECULATION=dflash2

# Qualification-only fixed DFlash2 verification width (1..7). Empty selects
# the adaptive verifier while retaining the K7 proposal graph. Use plain for
# the target-only baseline.
DFLASH2_FIXED_DRAFTS=

# Candidate-selection backend. Keep torch until the FlashInfer radix variants
# pass exact-output and end-to-end C1/C2/C4 performance qualification.
# Values: torch | flashinfer | flashinfer-dsa.
DFLASH2_TOPK_BACKEND=torch

##########################
# Coordinator SparkInfer #
##########################
# auto selects the qualified GLM H64 BF16 query projection shapes. disable is
# the release A/B control; force is diagnostic and still falls back on
# unsupported shapes.
# SPARKINFER_GLM_H64_QUERY_PROJECTION=auto

##############
# Networking #
##############
# ADDR=0.0.0.0:8000
# EXPERT_PORT=9100

SPARK_0_HOST=ostrich
SPARK_1_HOST=dodo
SPARK_2_HOST=emu
SPARK_3_HOST=kiwi
SPARK_0_LANE_A=10.55.0.1
SPARK_1_LANE_A=10.55.0.2
SPARK_2_LANE_A=10.55.0.3
SPARK_3_LANE_A=10.55.0.4

# Optional secondary Spark-to-Spark reduction rail: set all four or none.
SPARK_0_LANE_B=10.55.0.5
SPARK_1_LANE_B=10.55.0.6
SPARK_2_LANE_B=10.55.0.7
SPARK_3_LANE_B=10.55.0.8

####################
# Build and deploy #
####################
COORDINATOR_DOCKER_DEV=glrmt-coordinator-dev
COORDINATOR_DOCKER_INFERENCE=glrmt-coordinator
SPARK_EXPERT_DOCKER_DEV=glrmt-spark-expert-dev
SPARK_EXPERT_DOCKER_INFERENCE=glrmt-spark-expert
